# NeuralNexus — Node 2 configuration
# Copy this file to node2/.env and fill in the values.
#
# AES_SECRET — must be IDENTICAL to node1/.env and node3/.env
# NODE_ID    — must match this node's row in the node_discovery table (unique per node)
#
# See server/.env.example for generation instructions.

AES_SECRET=replace-with-a-strong-random-secret
NODE_ID=replace-with-node2-uuid-from-node_discovery
