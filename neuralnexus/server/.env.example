# NeuralNexus — Node 1 configuration
# Copy this file to .env and fill in the values.
#
# AES_SECRET
#   A strong random string used to encrypt/decrypt session tokens.
#   ALL nodes in the cluster MUST share the exact same value.
#   Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
#
# NODE_ID
#   The UUID that identifies THIS node inside the Raft cluster.
#   Must match the `id` column of this node's row in the node_discovery table.
#   Generate one with:  python -c "import uuid; print(uuid.uuid4())"
#   Then insert it into node_discovery (see seed_db.py or docs/development-guide.md).

AES_SECRET=replace-with-a-strong-random-secret
NODE_ID=replace-with-this-nodes-uuid-from-node_discovery
