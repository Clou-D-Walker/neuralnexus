# Verified against 'What to push' checklist
# ── Virtual environment ────────────────────────────────────────────────────────
env/
venv/
.venv/

# ── Secrets / environment files ───────────────────────────────────────────────
# .env.example files ARE committed (they're templates with no real values).
# Actual .env files are NEVER committed.
.env
neuralnexus/server/.env
neuralnexus/server/node2/.env
neuralnexus/server/node3/.env

# ── Databases ─────────────────────────────────────────────────────────────────
# SQLite files may contain real user data (hashed passwords, emails, etc.)
*.db
*.sqlite
*.sqlite3

# ── Original college submission ───────────────────────────────────────────────
AOS-LMS-M3/

# ── Scratch / personal notes ──────────────────────────────────────────────────
extra.txt
to-do.txt

# ── Python cache ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# ── Generated gRPC stubs ──────────────────────────────────────────────────────
# These are regenerated by generate_proto_code.bat / gen_proto_code.bat
neuralnexus/server/proto/Lms_pb2.py
neuralnexus/server/proto/Lms_pb2.pyi
neuralnexus/server/proto/Lms_pb2_grpc.py
neuralnexus/client/Lms_pb2.py
neuralnexus/client/Lms_pb2.pyi
neuralnexus/client/Lms_pb2_grpc.py

# ── Model files ───────────────────────────────────────────────────────────────
# GGUF models are large binary files — distribute separately
*.gguf
neuralnexus/server/Model/

# ── OS / editor junk ──────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
*.egg-info/
dist/
build/
